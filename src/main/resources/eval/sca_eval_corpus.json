    "ingestionTraceId": "eval-sca-spring",
    "chunks": [
      {
        "chunkId": 1,
        "textContent": "SCA 修复证据：Spring Framework 5.3.17 受 Spring4Shell（CVE-2022-22965）影响。5.3.x 分支的修复版本为 5.3.18，排查时需要确认 spring-webmvc、spring-beans 等相关模块版本一起升级。"
      }
    ]
  },
  {
    "fileMd5": "33333333333333333333333333333333",
