      {
        "chunkId": 1,
        "textContent": "SCA 修复证据：log4j-core 2.14.1 受 CVE-2021-44228 影响，该漏洞通常称为 Log4Shell。组件使用 2.14.1 时应升级到 2.15.0 或更高的安全版本，并确认运行时没有继续加载旧版本依赖。"
      }
    ]
  },
  {
    "fileMd5": "22222222222222222222222222222222",
    "fileName": "eval-spring-framework-remediation.md",
    "userId": "1",
    "orgTag": "eval",
