#!/usr/bin/env sh
set -eu

zero_sha="0000000000000000000000000000000000000000"
changed_files="$(mktemp)"
saw_input=0
trap 'rm -f "$changed_files"' EXIT

while read -r local_ref local_sha remote_ref remote_sha
do
  saw_input=1
  local_sha="$(printf '%s' "$local_sha" | tr -d '\r')"
  remote_sha="$(printf '%s' "$remote_sha" | tr -d '\r')"

  [ -z "${local_ref:-}" ] && continue
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    git diff-tree --no-commit-id --name-only -r "$local_sha" >> "$changed_files"
  else
    git diff --name-only "$remote_sha..$local_sha" >> "$changed_files"
  fi
done

if [ ! -s "$changed_files" ] && [ "$saw_input" -eq 0 ]; then
  git diff --name-only HEAD~1..HEAD > "$changed_files" 2>/dev/null || true
fi

sort -u "$changed_files" -o "$changed_files"

rag_pattern='^(src/main/java/com/yizhaoqi/smartpai/(config/AiProperties\.java|entity/(agent|graph|rag)/|service/.*(Agentic|Graph|RagEval|Sca).+\.java)|src/main/resources/application\.yml|src/test/java/com/yizhaoqi/smartpai/service/.*(Agentic|Graph|RagEval|Sca).+Test\.java)$'

if ! grep -Eq "$rag_pattern" "$changed_files"; then
  echo "pre-push: no Agentic RAG, graph, SCA, or eval Java/config changes detected; skipping targeted Maven tests."
  exit 0
fi

echo "pre-push: relevant Agentic RAG/graph/SCA/eval changes detected."
echo "pre-push: running targeted Maven tests before push."

if [ -n "${MAVEN_CMD:-}" ]; then
  mvn_cmd="$MAVEN_CMD"
elif command -v mvn >/dev/null 2>&1; then
  mvn_cmd="mvn"
elif [ -f "C:/Users/Administrator/tools/apache-maven-3.9.10/bin/mvn.cmd" ]; then
  mvn_cmd="C:/Users/Administrator/tools/apache-maven-3.9.10/bin/mvn.cmd"
else
  echo "pre-push: Maven was not found. Set MAVEN_CMD or add mvn to PATH." >&2
  exit 1
fi

maven_repo_arg="${MAVEN_REPO_ARG:-}"
if [ -z "$maven_repo_arg" ] && [ -d "D:/PaiSmart-deps/maven-repository" ]; then
  maven_repo_arg="-Dmaven.repo.local=D:/PaiSmart-deps/maven-repository"
fi

"$mvn_cmd" $maven_repo_arg "-Dtest=AgenticRagServiceTest,GraphSearchServiceTest,GraphExtractionServiceTest" test
